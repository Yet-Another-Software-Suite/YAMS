{
  "fileName": "yams.json",
  "name": "Yet Another Mechanism System",
  "version": "${version}",
  "wpilibYear": "2027_alpha7",
  "uuid": "${uuid}",
  "mavenUrls": [
    "https://yet-another-software-suite.github.io/YAMS/releases/",
    "https://cdn.yassrobotics.com/"
  ],
  "jsonUrl": "https://yet-another-software-suite.github.io/YAMS/yams.json",
  "javaDependencies": [
    {
      "groupId": "${groupId}",
      "artifactId": "${artifactId}-core",
      "version": "${version}"
    }
  ],
  "cppDependencies": [
    {
      "groupId": "${groupId}",
      "artifactId": "${artifactId}-cpp",
      "version": "${version}",
      "libName": "YAMS",
      "headerClassifier": "headers",
      "sharedLibrary": true,
      "skipInvalidPlatforms": true,
      "binaryPlatforms": [
        "windowsx86-64",
        "linuxarm64",
        "linuxx86-64",
        "linuxsystemcore",
        "osxuniversal"
      ]
    }
  ],
  "jniDependencies": [],
  "requires": []
}
